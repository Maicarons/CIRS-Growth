require("version.nut");
// settings_text.nut is generated by tools/gen_settings.py from lang/*.txt.
// OpenTTD reads these description/label strings at scan time (before any
// translation is loaded), so the settings menu language is chosen at build
// time by make_tar.py --lang. See tools/gen_settings.py for details.
require("settings_text.nut");

class MainClass extends GSInfo
    {
    function GetAuthor()                { return "Firrel, Maicarons (CIRS adaptation)"; }
    function GetName()                  { return "CIRS Growth"; }
    function GetShortName()             { return "CIGR"; }
    function GetDescription()           { return "Towns require various cargo deliveries to grow. Required cargos can be randomized. Town growth is limited by percentage of transported specific cargos. Adapted for the CIRS industry NewGRF set. Based on Renewed Village Growth by Firrel."; }
    function GetURL()                   { return "https://github.com/Maicarons/CIRS-Growth"; }
    function GetVersion()               { return SELF_VERSION; }
    function GetDate()                  { return SELF_DATE; }
    function GetAPIVersion()            { return "14"; }
    function MinVersionToLoad()         { return SELF_MINLOADVERSION; }
    function CreateInstance()           { return "MainClass"; }
    function GetSettings() {

        AddSetting({ name = "town_info_mode",
                description = ::SettingsDesc.town_info_mode,
                easy_value = 1,
                medium_value = 1,
                hard_value = 1,
                custom_value = 1,
                flags = CONFIG_INGAME, min_value = 1, max_value = 5 });
        AddLabels("town_info_mode", ::SettingsLabel.town_info_mode);

        AddSetting({ name = "goal_scale_factor",
                description = ::SettingsDesc.goal_scale_factor,
                easy_value = 60,
                medium_value = 100,
                hard_value = 140,
                custom_value = 100,
                flags = CONFIG_INGAME, min_value = 1, max_value = 50000, step_size = 20 });

        AddSetting({ name = "use_town_sign",
                description = ::SettingsDesc.use_town_sign,
                easy_value = 1,
                medium_value = 1,
                hard_value = 1,
                custom_value = 1,
                flags = CONFIG_BOOLEAN | CONFIG_INGAME });

        AddSetting({ name = "eternal_love",
                description = ::SettingsDesc.eternal_love,
                easy_value = 1,
                medium_value = 3,
                hard_value = 0,
                custom_value = 0,
                flags = CONFIG_INGAME, min_value = 0, max_value = 3 });
        AddLabels("eternal_love", ::SettingsLabel.eternal_love);

        AddSetting({
                name = "cargo_6_category",
                description = ::SettingsDesc.cargo_6_category,
                easy_value = 1,
                medium_value = 1,
                hard_value = 1,
                custom_value = 1,
                flags = CONFIG_BOOLEAN | CONFIG_INGAME });

        AddSetting({ name = "cargo_randomization",
                description = ::SettingsDesc.cargo_randomization,
                easy_value = 1,
                medium_value = 7,
                hard_value = 10,
                custom_value = 10,
                flags = CONFIG_INGAME, min_value = 1, max_value = 15 });
        AddLabels("cargo_randomization", ::SettingsLabel.cargo_randomization);

        AddSetting({ name = "near_cargo_probability",
                    description = ::SettingsDesc.near_cargo_probability,
                    easy_value = 100,
                    medium_value = 50,
                    hard_value = 0,
                    custom_value = 50,
                    flags = CONFIG_INGAME, min_value = 0, max_value = 100, step_size = 10});

        AddSetting({ name = "display_cargo",
                description = ::SettingsDesc.display_cargo,
                easy_value = 1,
                medium_value = 0,
                hard_value = 0,
                custom_value = 0,
                flags = CONFIG_BOOLEAN | CONFIG_INGAME});

        AddSetting({ name = "raw_industry_density",
                description = ::SettingsDesc.raw_industry_density,
                easy_value = 0,
                medium_value = 0,
                hard_value = 0,
                custom_value = 0,
                flags = CONFIG_INGAME, min_value = 0, max_value = 5});
        AddLabels("raw_industry_density", ::SettingsLabel.raw_industry_density);

        AddSetting({
            name = "limit_min_transport",
