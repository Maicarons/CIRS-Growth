            easy_value = -1,
            medium_value = -1,
            hard_value = -1,
            custom_value = -1,
            flags = CONFIG_INGAME, min_value = -1, max_value = 100000, step_size = 100});

        AddSetting({
            name = "category_3_min_pop",
            description = ::SettingsDesc.category_3_min_pop,
            easy_value = -1,
            medium_value = -1,
            hard_value = -1,
            custom_value = -1,
            flags = CONFIG_INGAME, min_value = -1, max_value = 100000, step_size = 100});

        AddSetting({
            name = "category_4_min_pop",
            description = ::SettingsDesc.category_4_min_pop,
            easy_value = -1,
            medium_value = -1,
            hard_value = -1,
            custom_value = -1,
            flags = CONFIG_INGAME, min_value = -1, max_value = 100000, step_size = 100});

        AddSetting({
            name = "category_5_min_pop",
            description = ::SettingsDesc.category_5_min_pop,
            easy_value = -1,
            medium_value = -1,
            hard_value = -1,
            custom_value = -1,
            flags = CONFIG_INGAME, min_value = -1, max_value = 100000, step_size = 100});

        AddSetting({
            name = "category_6_min_pop",
            description = ::SettingsDesc.category_6_min_pop,
            easy_value = -1,
            medium_value = -1,
            hard_value = -1,
            custom_value = -1,
            flags = CONFIG_INGAME, min_value = -1, max_value = 100000, step_size = 100});

        AddSetting({ name = "town_growth_factor",
                description = ::SettingsDesc.town_growth_factor,
                easy_value = 50,
                medium_value = 100,
                hard_value = 200,
                custom_value = 100,
                flags = CONFIG_INGAME, min_value = 20, max_value = 50000, step_size = 20 });

        AddSetting({ name = "supply_impacting_part",
                description = ::SettingsDesc.supply_impacting_part,
                easy_value = 30,
                medium_value = 50,
                hard_value = 70,
                custom_value = 50,
                flags = CONFIG_INGAME, min_value = 0, max_value = 100, step_size = 5 });

        AddSetting({ name = "exponentiality_factor",
                description = ::SettingsDesc.exponentiality_factor,
                easy_value = 3,
                medium_value = 3,
                hard_value = 3,
                custom_value = 3,
                flags = CONFIG_INGAME, min_value = 1, max_value = 5 });

        AddSetting({ name = "lowest_town_growth_rate",
