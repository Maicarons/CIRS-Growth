            medium_value = 1,
            hard_value = 1,
            custom_value = 1,
            flags = CONFIG_INGAME, min_value = 0, max_value = 3});
        AddLabels("subsidies_type", ::SettingsLabel.subsidies_type);

        AddSetting({
            name = "category_1_min_pop",
